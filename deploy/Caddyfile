www.deutchquizarena.de {
  redir https://deutchquizarena.de{uri} 308
}

deutchquizarena.de {
  encode zstd gzip

  handle /webhook* {
    reverse_proxy api:8000
  }

  @health_legacy path /health
  @internal_ready path /api/ready /api/ready/*

  # Keep the legacy public health endpoint, but only with the sanitized backend payload.
  handle @health_legacy {
    reverse_proxy api:8000
  }

  # Detailed readiness remains container-local and must not be exposed publicly.
  handle @internal_ready {
    respond "Not Found" 404
  }

  handle_path /api/* {
    reverse_proxy api:8000
  }

  handle {
    reverse_proxy frontend:3000
  }

  tls {$CADDY_EMAIL}

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}
