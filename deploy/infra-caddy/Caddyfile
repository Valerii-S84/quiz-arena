# Draft target Caddyfile for future infra-caddy ownership.
# Routes intentionally preserve the current production behavior.

(quiz_arena_routes) {
	encode zstd gzip

	handle /webhook* {
		reverse_proxy api:8000
	}

	@health_legacy path /health
	@internal_ready path /api/ready /api/ready/*

	handle @health_legacy {
		reverse_proxy api:8000
	}

	handle @internal_ready {
		respond "Not Found" 404
	}

	handle /api/quiz-teaser/* {
		reverse_proxy frontend:3000
	}

	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:3000
	}

	tls {$CADDY_EMAIL}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

www.deutchquizarena.de {
	redir https://deutchquizarena.de{uri} 308
}

deutchquizarena.de {
	import quiz_arena_routes
	tls {$CADDY_EMAIL}
}

deutchquizarena.46.225.181.45.sslip.io {
	import quiz_arena_routes
	tls {$CADDY_EMAIL}
}

api.valerchik.de {
	encode zstd gzip

	@unauthorized not header X-API-Key {$API_QUIZ_BANK_PUBLIC_API_KEY}
	handle @unauthorized {
		respond "Unauthorized" 401
	}

	handle {
		reverse_proxy api-quiz-bank:8000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	tls {$CADDY_EMAIL}
}
